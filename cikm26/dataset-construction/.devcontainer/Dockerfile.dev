# docker build -f .devcontainer/Dockerfile.dev -t uniagent-dataset-construction-dev .
FROM python:3.12-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt requirements-umbrela.txt /tmp/requirements/
RUN python -m pip install --no-cache-dir \
    -r /tmp/requirements/requirements-umbrela.txt \
    && rm -rf /tmp/requirements

RUN pip3 install --no-cache-dir --force-reinstall --no-deps \
	"tira @ git+https://github.com/tira-io/tira.git@main#subdirectory=python-client"
